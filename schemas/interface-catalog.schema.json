{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corezilla.github.io/STD/schemas/interface-catalog.schema.json",
  "title": "STD interface and data catalog 2.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "required": [
    "schema_version",
    "repository",
    "families",
    "members"
  ],
  "additionalProperties": false,
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://)[^\\s]+$"
    },
    "selector": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "json_pointer",
            "literal"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ],
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_scope": {
          "enum": [
            "structure",
            "encoding",
            "signature",
            "error",
            "signal",
            "command"
          ]
        },
        "version_selector": {
          "$ref": "#/$defs/selector"
        },
        "revision_selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "repository",
        "path",
        "selector",
        "version",
        "revision",
        "sha256",
        "semantic_scope",
        "version_selector",
        "revision_selector"
      ],
      "additionalProperties": false
    },
    "prose": {
      "type": "object",
      "description": "Bind the existing STD cover/control and same-basename document metadata identity; hidden ID/version comments are not an authority.",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "repository",
        "path",
        "document_id",
        "version",
        "anchor"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "entry_only",
            "selected_members",
            "complete"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "excluded_scope": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "level",
        "scope",
        "excluded_scope",
        "inventory"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "downstream_inventory": {
          "$ref": "#/$defs/source",
          "description": "Pinned independent adoption scope, validated by downstream-scope.schema.json; never inferred from member.downstream rows."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "providers",
        "consumers",
        "downstream_inventory",
        "source",
        "coverage"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "description": "Roles/selectors for supported operation signatures must exactly cover source-declared type references, then match each registered target type.",
      "properties": {
        "role": {
          "enum": [
            "request",
            "response",
            "event",
            "field",
            "shared",
            "alias",
            "conversion",
            "error"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "mapping": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "target",
        "selector"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "alias",
                  "conversion"
                ]
              }
            }
          },
          "then": {
            "required": [
              "mapping"
            ]
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "design": {
          "enum": [
            "proposed",
            "in_review",
            "approved",
            "deprecated"
          ]
        },
        "implementation": {
          "enum": [
            "not_implemented",
            "partial",
            "implemented"
          ]
        },
        "verification": {
          "enum": [
            "not_run",
            "blocked",
            "fail",
            "pass"
          ]
        }
      },
      "required": [
        "design",
        "implementation",
        "verification"
      ],
      "additionalProperties": false
    },
    "downstream": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "provider",
            "consumer"
          ]
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ],
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation": {
          "enum": [
            "not_implemented",
            "partial",
            "implemented"
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "repository",
                "path"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "$ref": "#/$defs/path"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "enum": [
            "not_run",
            "blocked",
            "fail",
            "pass"
          ]
        },
        "design_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verification_ref": {
          "$ref": "#/$defs/prose"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "role",
        "module",
        "backend",
        "version",
        "revision",
        "source_sha256",
        "implementation",
        "location",
        "symbol",
        "verification",
        "design_items",
        "cases",
        "verification_ref",
        "runs"
      ],
      "additionalProperties": false
    },
    "evolution": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "replaced_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "replaced_by",
        "compatibility"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+#[A-Za-z0-9._-]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "type",
            "operation",
            "error",
            "command",
            "signal",
            "register",
            "event"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "prose": {
          "$ref": "#/$defs/prose"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evolution": {
          "$ref": "#/$defs/evolution"
        },
        "downstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/downstream"
          }
        },
        "reading_view": {
          "anyOf": [
            {
              "$ref": "#/$defs/prose"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "family",
        "kind",
        "name",
        "source",
        "prose",
        "bindings",
        "status",
        "evolution",
        "downstream",
        "reading_view"
      ],
      "additionalProperties": false
    }
  }
}
