{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corezilla.example/std/schemas/validation-result.schema.json",
  "title": "STD structural validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ok", "new_error_count", "inherited_error_count",
    "checked_metadata", "checked_markdown", "issues"
  ],
  "properties": {
    "schema_version": {"const": "std-validation-result.v1"},
    "ok": {"type": "boolean"},
    "new_error_count": {"type": "integer", "minimum": 0},
    "inherited_error_count": {"type": "integer", "minimum": 0},
    "checked_metadata": {"type": "integer", "minimum": 0},
    "checked_markdown": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message", "fingerprint", "classification"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "classification": {"enum": ["new", "inherited"]}
        }
      }
    }
  }
}
