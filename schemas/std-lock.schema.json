{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corezilla.example/std/schemas/std-lock.schema.json",
  "title": "STD adoption lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "std_version", "source_repository", "source_revision",
    "source_manifest_path", "adopted_at", "project_profile", "enabled_domains"
  ],
  "properties": {
    "schema_version": {"const": "std-lock.v1"},
    "std_version": {"type": "string", "minLength": 1},
    "source_repository": {"type": "string", "minLength": 1},
    "source_revision": {"type": ["string", "null"]},
    "source_manifest_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "adopted_at": {"type": "string", "format": "date"},
    "project_profile": {
      "enum": ["software", "mixed-system", "hardware-fpga", "documentation-only"]
    },
    "enabled_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["management", "systems", "software", "hardware", "firmware", "fpga", "mechanical", "operations", "mixed"]
      }
    }
  }
}
