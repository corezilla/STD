{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corezilla.example/std/schemas/document-metadata.schema.json",
  "title": "STD document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project", "authority", "document_id", "document_type", "document_version", "title",
    "document_owner", "authors", "source_repository", "source_path",
    "template_id", "template_version", "template_sha256",
    "template_conformance", "tailoring_ref", "migration_map_ref",
    "design_level", "domain", "status", "visibility", "reviewed_commit",
    "created_at", "last_modified_at"
  ],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "document_type": {"type": "string", "minLength": 1},
    "document_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "title": {"type": "string", "minLength": 1},
    "document_owner": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "template_id": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "template_conformance": {"enum": ["native", "tailored", "legacy-mapped"]},
    "tailoring_ref": {
      "description": "项目内 management.tailoring 文档的 Document ID",
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "migration_map_ref": {
      "description": "项目根相对的 migration map 文件路径",
      "type": ["string", "null"],
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "design_level": {
      "enum": ["project", "system", "subsystem", "module", "component", "implementation-unit", "cross-level"]
    },
    "domain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["management", "systems", "software", "hardware", "firmware", "fpga", "mechanical", "operations", "mixed"]}
    },
    "status": {"enum": ["draft", "review", "accepted", "released", "superseded", "retired"]},
    "visibility": {"enum": ["private", "project", "organization", "public"]},
    "source_repository": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "reviewed_commit": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "parent_document_id": {"type": ["string", "null"], "description": "直属父对象的设计 Document ID，不是依赖或模板类型。子系统可递归，design_level 始终为 subsystem；完整父链由显式 hierarchy 检查核对。"},
    "supersedes": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date"},
    "last_modified_at": {"type": "string", "format": "date"}
  },
  "allOf": [
    {
      "if": {"properties": {"template_conformance": {"const": "native"}}},
      "then": {
        "properties": {
          "tailoring_ref": {"const": null},
          "migration_map_ref": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"template_conformance": {"const": "tailored"}}},
      "then": {
        "properties": {"tailoring_ref": {"type": "string", "minLength": 1}}
      }
    },
    {
      "if": {"properties": {"template_conformance": {"const": "legacy-mapped"}}},
      "then": {
        "properties": {"migration_map_ref": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
