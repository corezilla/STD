{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corezilla.example/std/schemas/review-decision.schema.json",
  "title": "STD review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "packet_id", "verdict",
    "document_status_before", "requested_document_status_after",
    "runtime_activation_requested", "reviewers", "decided_at"
  ],
  "properties": {
    "schema_version": {"const": "std-review-decision.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "verdict": {
      "enum": ["PENDING", "NOT_REVIEWED", "ACCEPTED", "AMENDMENT", "REJECTED", "BLOCKED"]
    },
    "document_status_before": {
      "enum": ["draft", "review", "accepted", "released", "superseded", "retired"]
    },
    "requested_document_status_after": {
      "enum": ["unchanged", "draft", "review", "accepted", "released", "superseded", "retired"]
    },
    "runtime_activation_requested": {"type": "boolean"},
    "runtime_activation_authority": {"type": ["string", "null"]},
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decided_at": {"type": ["string", "null"], "format": "date-time"},
    "decision_commit": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"}
  }
}
