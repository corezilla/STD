{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/std/ex-export-v1.schema.json",
  "title": "Fictional EX-EXPORT-01/v1 complete teaching contract",
  "x-contract-version": "EX-EXPORT-01/v1",
  "x-revision": "3",
  "x-behavior-authority": "docs/examples/mechanism-side-effect-example.md#contract-behavior",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
      "$comment": "1–64 ASCII characters; opaque identity, not credentials; no default/null"
    },
    "Payload": {
      "type": "string",
      "maxLength": 4096,
      "x-max-utf8-bytes": 4096,
      "$comment": "Frozen input, empty allowed; <=4096 UTF-8 bytes (byte bound needs encoding check); no implicit conversion or appended LF."
    },
    "EmptyArgs": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "PrepareArgs": {
      "type": "object",
      "properties": {
        "slot_id": {
          "const": "slot-1",
          "$comment": "Only teaching slot; ownership remains A"
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      },
      "required": [
        "slot_id",
        "payload"
      ],
      "additionalProperties": false
    },
    "FinalizeArgs": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": [
            "deliver",
            "discard"
          ],
          "$comment": "Explicit selected branch; immutable after finalize"
        }
      },
      "required": [
        "disposition"
      ],
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "PREPARED",
            "EXECUTING",
            "STOPPING",
            "STOPPED",
            "FINALIZED",
            "RELEASED"
          ]
        },
        "result": {
          "enum": [
            "NOT_STARTED",
            "UNKNOWN",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "access": {
          "enum": [
            "OPEN",
            "CLOSING",
            "FENCED"
          ]
        },
        "evidence": {
          "enum": [
            "PENDING",
            "CAPTURED",
            "UNRECOVERABLE"
          ]
        },
        "disposition": {
          "enum": [
            null,
            "deliver",
            "discard"
          ]
        },
        "resource": {
          "enum": [
            "HELD",
            "RELEASED"
          ]
        },
        "admission": {
          "enum": [
            "BLOCKED",
            "ELIGIBLE"
          ]
        }
      },
      "required": [
        "phase",
        "result",
        "access",
        "evidence",
        "disposition",
        "resource",
        "admission"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "STOPPED",
                  "FINALIZED",
                  "RELEASED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "access": {
                "const": "FENCED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "FINALIZED",
                  "RELEASED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "enum": [
                  "CAPTURED",
                  "UNRECOVERABLE"
                ]
              },
              "disposition": {
                "enum": [
                  "deliver",
                  "discard"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "RELEASED"
              }
            }
          },
          "then": {
            "properties": {
              "resource": {
                "const": "RELEASED"
              },
              "admission": {
                "const": "ELIGIBLE"
              }
            }
          },
          "else": {
            "properties": {
              "resource": {
                "const": "HELD"
              },
              "admission": {
                "const": "BLOCKED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "PREPARED"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "NOT_STARTED"
              },
              "access": {
                "const": "OPEN"
              },
              "evidence": {
                "const": "PENDING"
              },
              "disposition": {
                "type": "null"
              }
            }
          }
        }
      ],
      "$comment": "All fields required; separate five-axis meanings and legal transitions at prose EX-R1–8; no implicit defaults."
    },
    "Output": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "maxLength": 5464,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "encoding",
        "data",
        "sha256"
      ],
      "additionalProperties": false,
      "$comment": "Validate decoded <=4096 bytes, SHA-256 and equality to frozen payload UTF-8; schema alone cannot prove these."
    },
    "Request": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "EX-EXPORT-01/v1"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "agent_instance": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "enum": [
            "prepare",
            "execute",
            "inspect",
            "stop",
            "collect",
            "finalize",
            "release"
          ]
        },
        "args": {
          "oneOf": [
            {
              "$ref": "#/$defs/PrepareArgs"
            },
            {
              "$ref": "#/$defs/FinalizeArgs"
            },
            {
              "$ref": "#/$defs/EmptyArgs"
            }
          ]
        }
      },
      "required": [
        "protocol",
        "request_id",
        "agent_instance",
        "operation_id",
        "op",
        "args"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "prepare"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/PrepareArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "execute"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/EmptyArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "inspect"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/EmptyArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "stop"
