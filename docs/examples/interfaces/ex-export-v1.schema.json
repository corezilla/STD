            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/EmptyArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "collect"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/EmptyArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "finalize"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/FinalizeArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "release"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/EmptyArgs"
              }
            }
          }
        }
      ],
      "$comment": "No unknown/duplicate keys; JSON Lines <=8192 bytes; UID is authenticated via peer credentials, not payload."
