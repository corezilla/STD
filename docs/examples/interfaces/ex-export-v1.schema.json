        "protocol",
        "request_id",
        "agent_instance",
        "operation_id",
        "ok",
        "state",
        "output"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "output": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "result": {
                    "const": "SUCCEEDED"
                  },
                  "evidence": {
                    "const": "CAPTURED"
                  },
                  "disposition": {
                    "const": "deliver"
                  },
                  "phase": {
                    "enum": [
                      "FINALIZED",
                      "RELEASED"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "$comment": "<=16384 bytes; correlate all four identity fields to current request. Output only for successful/repeated finalize(deliver); cannot establish this from response alone."
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "EX-EXPORT-01/v1"
        },
        "request_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_instance": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "agent_instance",
        "operation_id",
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "$comment": "Unparseable correlation fields null; state/output absent. Errors and connection uncertainty follow prose, not automatic retry."
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuccessResponse"
        },
        {
          "$ref": "#/$defs/ErrorResponse"
        }
      ]
    },
    "CompletionReceipt": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "EX-EXPORT-01/v1"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "agent_instance": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "slot_id": {
          "const": "slot-1"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "output": {
          "oneOf": [
            {
              "$ref": "#/$defs/Output"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol",
        "request_id",
        "agent_instance",
        "operation_id",
        "slot_id",
        "payload_sha256",
        "result",
        "output"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "output": {
                "$ref": "#/$defs/Output"
              }
            }
          }
        }
      ],
      "$comment": "Internal A/W receipt, not new C→A operation; binds FIRST execute request_id and frozen payload. Ingress closes atomically with fencing per EX-R5."
    }
