#!/usr/bin/env python3
"""把共享文档封面同步到 catalog 中的所有 Markdown 模板。"""

from __future__ import annotations

import json
import re
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
BEGIN = "<!-- STD_DOCUMENT_COVER_BEGIN -->"
END = "<!-- STD_DOCUMENT_COVER_END -->"


def main() -> int:
    catalog = json.loads((ROOT / "templates/catalog.json").read_text())
    cover = (ROOT / "templates/_shared/document-cover.md").read_text().strip()
    changed = 0
    for relative in catalog["templates"].values():
        path = ROOT / "templates" / relative
        text = path.read_text()
        if BEGIN in text:
            pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.DOTALL)
            updated, count = pattern.subn(cover, text, count=1)
            if count != 1:
                raise RuntimeError(f"无法更新封面: {path}")
        else:
            updated, count = re.subn(r"\A#\s+\{\{document_title\}\}\s*", cover + "\n\n", text, count=1)
            if count != 1:
                raise RuntimeError(f"模板没有标准一级标题: {path}")
        if updated != text:
            path.write_text(updated)
            changed += 1
    print(f"synchronized {len(catalog['templates'])} templates; changed {changed}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
