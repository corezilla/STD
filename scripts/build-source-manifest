#!/usr/bin/env python3
"""生成独立于 RAG 的 STD 来源锁定清单。"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SOURCE_DIRS = ("docs", "templates", "schemas", "scripts", "examples")
SOURCE_FILES = ("VERSION", "README.md", "THIRD_PARTY_NOTICES.md", "MIGRATION_HANDOFF.md")


def role_for(path: Path) -> str:
    if path.parts[0] == "templates":
        return "template"
    if path.parts[0] == "schemas":
        return "schema"
    if path.parts[0] == "scripts":
        return "tool"
    if path.parts[0] == "examples":
        return "example"
    return "guidance"


def source_paths(excluded: Path) -> list[Path]:
    paths = [ROOT / name for name in SOURCE_FILES]
    for directory in SOURCE_DIRS:
        paths.extend(
            path for path in (ROOT / directory).rglob("*")
            if path.is_file() and "__pycache__" not in path.parts
        )
    return sorted({path for path in paths if path.resolve() != excluded})


def git_revision() -> str | None:
    try:
        return subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--source-repository", default="corezilla/architecture-standards")
    parser.add_argument("--source-revision", help="immutable Git commit 或 tag；默认读取 STD Git HEAD")
    parser.add_argument("--force", action="store_true", help="覆盖已有 source manifest")
    args = parser.parse_args()

    output = args.output.resolve()
    if output.exists() and not args.force:
        parser.error("目标已存在；确认升级来源后使用 --force")

    artifacts = []
    for path in source_paths(output):
        relative = path.relative_to(ROOT)
        artifacts.append({
            "path": relative.as_posix(),
            "role": role_for(relative),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        })

    source_revision = args.source_revision or git_revision()
    manifest = {
        "schema_version": "std-source-manifest.v1",
        "std_version": (ROOT / "VERSION").read_text().strip(),
        "source_repository": args.source_repository,
        "source_revision": source_revision,
        "generated_at": dt.date.today().isoformat(),
        "artifacts": artifacts,
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    print(f"{output}: {len(artifacts)} artifacts")
    if source_revision is None:
        print("warning: source_revision is null; SHA-256 manifest is a temporary source lock")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
