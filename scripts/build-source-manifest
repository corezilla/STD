#!/usr/bin/env python3
"""生成独立于 RAG 的 STD 来源锁定清单。"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SOURCE_DIRS = ("docs", "templates", "schemas", "scripts", "examples")
SOURCE_FILES = ("VERSION", "README.md", "THIRD_PARTY_NOTICES.md", "MIGRATION_HANDOFF.md")
EXCLUDED_SOURCE_DIRS = {".git", "__pycache__"}
EXCLUDED_SOURCE_NAMES = {".DS_Store"}


def role_for(path: Path) -> str:
    if path.parts[0] == "templates":
        return "template"
    if path.parts[0] == "schemas":
        return "schema"
    if path.parts[0] == "scripts":
        return "tool"
    if path.parts[0] == "examples":
        return "example"
    return "guidance"


def source_paths(root: Path, excluded: Path) -> list[Path]:
    selectors = [*SOURCE_FILES, *SOURCE_DIRS]
    try:
        output = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z", "--", *selectors],
            check=True, capture_output=True,
        ).stdout
        paths = []
        for encoded_name in output.split(b"\0"):
            if not encoded_name:
                continue
            path = root / encoded_name.decode("utf-8", errors="surrogateescape")
            if path.is_file() and not path.is_symlink():
                paths.append(path)
        return sorted({path for path in paths if path.resolve() != excluded})
    except (OSError, subprocess.CalledProcessError):
        pass

    paths = [
        root / name for name in SOURCE_FILES
        if (root / name).is_file() and not (root / name).is_symlink()
    ]
    for directory in SOURCE_DIRS:
        source_dir = root / directory
        if not source_dir.is_dir() or source_dir.is_symlink():
            continue
        for current, child_dirs, filenames in os.walk(source_dir, followlinks=False):
            child_dirs[:] = sorted(name for name in child_dirs if name not in EXCLUDED_SOURCE_DIRS)
            base = Path(current)
            for name in filenames:
                path = base / name
                if name not in EXCLUDED_SOURCE_NAMES and path.is_file() and not path.is_symlink():
                    paths.append(path)
    return sorted({path for path in paths if path.resolve() != excluded})


def git_revision() -> str | None:
    try:
        return subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def annotated_tag_commit(tag: str) -> str:
    object_type = subprocess.run(
        ["git", "-C", str(ROOT), "cat-file", "-t", tag],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    if object_type != "tag":
        raise ValueError(f"source tag 必须是 annotated tag: {tag}")
    return subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", f"{tag}^{{commit}}"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()


def git_checkout_is_clean() -> bool:
    return not subprocess.run(
        ["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=all"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--source-repository", default="corezilla/STD")
    parser.add_argument("--source-revision", help="完整 40 位 Git commit SHA；默认读取 STD Git HEAD")
    parser.add_argument("--source-tag", help="可选 annotated tag；必须 peel 到 source revision")
    parser.add_argument("--force", action="store_true", help="覆盖已有 source manifest")
    args = parser.parse_args()

    output = args.output.resolve()
    if output.exists() and not args.force:
        parser.error("目标已存在；确认升级来源后使用 --force")

    artifacts = []
    for path in source_paths(ROOT, output):
        relative = path.relative_to(ROOT)
        artifacts.append({
            "path": relative.as_posix(),
            "role": role_for(relative),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        })

    source_revision = args.source_revision or git_revision()
    if source_revision is not None and not re.fullmatch(r"[a-f0-9]{40}", source_revision):
        parser.error("source_revision 必须是完整 40 位小写 Git commit SHA")
    if source_revision is not None:
        try:
            if not git_checkout_is_clean():
                parser.error("不能从 dirty STD checkout 生成 immutable source manifest；请先 commit")
        except (OSError, subprocess.CalledProcessError) as exc:
            parser.error(f"无法验证 STD Git checkout: {exc}")
    if args.source_tag:
        try:
            if annotated_tag_commit(args.source_tag) != source_revision:
                parser.error("source_tag 没有 peel 到 source_revision")
        except (OSError, subprocess.CalledProcessError, ValueError) as exc:
            parser.error(str(exc))
    manifest = {
        "schema_version": "std-source-manifest.v1",
        "std_version": (ROOT / "VERSION").read_text().strip(),
        "source_repository": args.source_repository,
        "source_revision": source_revision,
        "source_tag": args.source_tag,
        "generated_at": dt.date.today().isoformat(),
        "artifacts": artifacts,
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    print(f"{output}: {len(artifacts)} artifacts")
    if source_revision is None:
        print("warning: source_revision is null; SHA-256 manifest is a temporary source lock")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
