#!/usr/bin/env python3
"""对当前 STD 工作树校验项目保存的来源清单。"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import subprocess
from pathlib import Path


DEFAULT_ROOT = Path(__file__).resolve().parents[1]
ROLES = {"template", "schema", "tool", "example", "guidance"}
SOURCE_DIRS = ("docs", "templates", "schemas", "scripts", "examples")
SOURCE_FILES = ("VERSION", "README.md", "THIRD_PARTY_NOTICES.md", "MIGRATION_HANDOFF.md")


def expected_paths(root: Path) -> set[str]:
    paths = [root / name for name in SOURCE_FILES]
    for directory in SOURCE_DIRS:
        paths.extend(
            path for path in (root / directory).rglob("*")
            if path.is_file() and "__pycache__" not in path.parts
        )
    return {path.relative_to(root).as_posix() for path in paths}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("manifest", type=Path)
    parser.add_argument("--std-root", type=Path, default=DEFAULT_ROOT,
                        help="要校验的 STD checkout 根目录；默认使用脚本所在 checkout")
    args = parser.parse_args()
    root = args.std_root.resolve()

    if not (root / "VERSION").is_file():
        parser.error(f"STD root 无效，缺少 VERSION: {root}")

    try:
        data = json.loads(args.manifest.read_text())
    except Exception as exc:
        parser.error(f"manifest 无法解析: {exc}")

    errors: list[str] = []
    if data.get("schema_version") != "std-source-manifest.v1":
        errors.append("schema_version 必须为 std-source-manifest.v1")
    if data.get("std_version") != (root / "VERSION").read_text().strip():
        errors.append("std_version 与当前 STD 工作树不一致")
    if not isinstance(data.get("source_repository"), str) or not data["source_repository"]:
        errors.append("source_repository 必须是非空字符串")
    if data.get("source_revision") is not None and not re.fullmatch(r"[a-f0-9]{40}", data["source_revision"]):
        errors.append("source_revision 必须是完整 40 位小写 Git commit SHA 或 null")
    elif data.get("source_revision"):
        try:
            locked_commit = subprocess.run(
                ["git", "-C", str(root), "rev-parse", f"{data['source_revision']}^{{commit}}"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            checkout_commit = subprocess.run(
                ["git", "-C", str(root), "rev-parse", "HEAD"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            if locked_commit != checkout_commit:
                errors.append("source_revision 与 --std-root checkout HEAD 不一致")
            dirty = subprocess.run(
                ["git", "-C", str(root), "status", "--porcelain", "--untracked-files=all"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            if dirty:
                errors.append("--std-root checkout 不是 clean，不能证明 source_revision 的内容完整性")
        except (OSError, subprocess.CalledProcessError):
            errors.append("source_revision 无法在 --std-root checkout 中解析")
    source_tag = data.get("source_tag")
    if source_tag is not None:
        if not isinstance(source_tag, str) or not source_tag:
            errors.append("source_tag 必须是非空字符串或 null")
        else:
            try:
                tag_type = subprocess.run(
                    ["git", "-C", str(root), "cat-file", "-t", source_tag],
                    check=True, capture_output=True, text=True,
                ).stdout.strip()
                tag_commit = subprocess.run(
                    ["git", "-C", str(root), "rev-parse", f"{source_tag}^{{commit}}"],
                    check=True, capture_output=True, text=True,
                ).stdout.strip()
                if tag_type != "tag":
                    errors.append("source_tag 不是 annotated tag")
                if tag_commit != data.get("source_revision"):
                    errors.append("source_tag 没有 peel 到 source_revision")
            except (OSError, subprocess.CalledProcessError):
                errors.append("source_tag 无法在 --std-root checkout 中解析")
    try:
        dt.date.fromisoformat(data.get("generated_at", ""))
    except (TypeError, ValueError):
        errors.append("generated_at 必须是 YYYY-MM-DD")
    artifacts = data.get("artifacts")
    if not isinstance(artifacts, list) or not artifacts:
        errors.append("artifacts 必须是非空数组")
        artifacts = []

    seen: set[str] = set()
    for index, artifact in enumerate(artifacts):
        if not isinstance(artifact, dict):
            errors.append(f"artifacts[{index}] 不是 object")
            continue
        relative = artifact.get("path", "")
        path = Path(relative)
        if not relative or path.is_absolute() or ".." in path.parts:
            errors.append(f"artifacts[{index}].path 非法: {relative}")
            continue
        if relative in seen:
            errors.append(f"重复 artifact path: {relative}")
            continue
        seen.add(relative)
        if artifact.get("role") not in ROLES:
            errors.append(f"{relative}: role 非法")
        if not re.fullmatch(r"[a-f0-9]{64}", artifact.get("sha256", "")):
            errors.append(f"{relative}: SHA-256 格式非法")
        source = root / path
        if not source.is_file():
            errors.append(f"{relative}: 当前 STD 源文件不存在")
            continue
        actual = hashlib.sha256(source.read_bytes()).hexdigest()
        if artifact.get("sha256") != actual:
            errors.append(f"{relative}: SHA-256 不一致")

    expected = expected_paths(root)
    missing = sorted(expected - seen)
    unexpected = sorted(seen - expected)
    if missing:
        errors.append("清单漏掉应锁定文件: " + ", ".join(missing))
    if unexpected:
        errors.append("清单包含非预期路径: " + ", ".join(unexpected))

    if errors:
        print("STD source manifest verification failed:")
        for error in errors:
            print(f"- {error}")
        return 1
    print(f"STD source manifest verification OK: {len(artifacts)} artifacts")
    if data.get("source_revision") is None:
        print("warning: source_revision is null; verification covers file hashes only")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
