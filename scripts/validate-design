#!/usr/bin/env python3
"""STD 文档实例结构、Schema、封面、来源与链接 validator。"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

try:
    import jsonschema
except ImportError:
    jsonschema = None


ROOT = Path(__file__).resolve().parents[1]
FINGERPRINT_ROOT: Path | None = None
EXCLUDED_PARTS = {
    ".git", ".cache", ".local", ".venv", "__pycache__", "node_modules",
    "vendor", "third_party", "build", "dist", "DATA"
}
STD_SOURCE_DIRS = ("docs", "templates", "schemas", "scripts", "examples")
STD_SOURCE_FILES = ("VERSION", "README.md", "THIRD_PARTY_NOTICES.md", "MIGRATION_HANDOFF.md")
EXCLUDED_SOURCE_NAMES = {".DS_Store"}
STATUS_LABELS = {
    "draft": "Draft", "review": "In Review", "accepted": "Approved",
    "released": "Released", "superseded": "Superseded", "retired": "Retired"
}
COVER_MAP = {
    "Document ID": "document_id", "Document Version": "document_version",
    "Status": "status", "Project": "project", "Authority": "authority",
    "Document Owner": "document_owner", "Authors": "authors",
    "Created Date": "created_at", "Last Modified Date": "last_modified_at",
    "Template ID": "template_id", "Template Version": "template_version",
    "Template Conformance": "template_conformance",
    "Tailoring Reference": "tailoring_ref",
    "Migration Map Reference": "migration_map_ref",
    "Repository": "source_repository", "Canonical Path": "source_path",
    "Supersedes": "supersedes",
}
COMPACT_COVER_FIELDS = {
    "Document ID", "Document Version", "Status", "Project", "Document Owner",
    "Last Modified Date", "Template ID", "Template Version",
}


def load_json(path: Path):
    return json.loads(path.read_text())


def issue(code: str, path: Path, message: str) -> dict:
    try:
        stable_path = path.resolve().relative_to(FINGERPRINT_ROOT).as_posix() if FINGERPRINT_ROOT else str(path)
    except ValueError:
        stable_path = str(path)
    fingerprint = hashlib.sha256(f"{code}|{stable_path}|{message}".encode()).hexdigest()
    return {"code": code, "path": str(path), "message": message, "fingerprint": fingerprint}


def schema_issues(path: Path, data, schema: dict, code: str) -> list[dict]:
    validator = jsonschema.Draft202012Validator(
        schema, format_checker=jsonschema.FormatChecker()
    )
    result = []
    for error in sorted(validator.iter_errors(data), key=lambda item: list(item.absolute_path)):
        location = "/".join(str(part) for part in error.absolute_path) or "<root>"
        result.append(issue(code, path, f"{location}: {error.message}"))
    return result


def discover(root: Path, suffix: str) -> list[Path]:
    if root.is_file():
        return [root] if root.name.endswith(suffix) else []
    if (root / ".git").exists():
        try:
            output = subprocess.run(
                ["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
                check=True, capture_output=True,
            ).stdout
            found = set()
            for encoded_name in output.split(b"\0"):
                if not encoded_name:
                    continue
                name = encoded_name.decode("utf-8", errors="surrogateescape")
                path = root / name
                if name.endswith(suffix) and path.is_file() and not path.is_symlink():
                    found.add(path)
            return sorted(found)
        except (OSError, subprocess.CalledProcessError):
            pass
    found: list[Path] = []
    for directory, child_dirs, filenames in os.walk(root, followlinks=False):
        child_dirs[:] = sorted(name for name in child_dirs if name not in EXCLUDED_PARTS)
        base = Path(directory)
        for name in filenames:
            if name.endswith(suffix):
                path = base / name
                if path.is_file() and not path.is_symlink():
                    found.append(path)
    return sorted(found)


def source_files(root: Path) -> list[Path]:
    selectors = [*STD_SOURCE_FILES, *STD_SOURCE_DIRS]
    try:
        output = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z", "--", *selectors],
            check=True, capture_output=True,
        ).stdout
        paths = []
        for encoded_name in output.split(b"\0"):
            if not encoded_name:
                continue
            path = root / encoded_name.decode("utf-8", errors="surrogateescape")
            if path.is_file() and not path.is_symlink():
                paths.append(path)
        return sorted(set(paths))
    except (OSError, subprocess.CalledProcessError):
        pass

    paths = [
        root / name for name in STD_SOURCE_FILES
        if (root / name).is_file() and not (root / name).is_symlink()
    ]
    for directory in STD_SOURCE_DIRS:
        source_dir = root / directory
        if not source_dir.is_dir() or source_dir.is_symlink():
            continue
        for current, child_dirs, filenames in os.walk(source_dir, followlinks=False):
            child_dirs[:] = sorted(name for name in child_dirs if name not in EXCLUDED_PARTS)
            base = Path(current)
            for name in filenames:
                path = base / name
                if name not in EXCLUDED_SOURCE_NAMES and path.is_file() and not path.is_symlink():
                    paths.append(path)
    return sorted(set(paths))


def expected_source_paths(root: Path = ROOT) -> set[str]:
    return {path.relative_to(root).as_posix() for path in source_files(root)}


def strip_cover_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == "`":
        value = value[1:-1]
    return value.strip()


def expected_cover_value(field: str, data: dict) -> str:
    value = data.get(COVER_MAP[field])
    if field == "Status":
        return STATUS_LABELS.get(value, str(value))
    if field == "Authors" and isinstance(value, list):
        return ", ".join(value)
    return "none" if value is None else str(value)


def validate_cover(path: Path, text: str, metadata: dict) -> list[dict]:
    """Shared bounded cover/control validation; never consults current template versions."""
    errors: list[dict] = []
    # Accept the legacy full cover, or a short cover plus a bounded end block.
    # Never collect identity rows from arbitrary design/example tables.
    blocks: dict[str, str] = {}
    cover_end = -1
    for kind in ("COVER", "CONTROL"):
        begin_marker = f"<!-- STD_DOCUMENT_{kind}_BEGIN -->"
        end_marker = f"<!-- STD_DOCUMENT_{kind}_END -->"
        if kind == "CONTROL" and begin_marker not in text and end_marker not in text:
            continue
        begin, end = text.find(begin_marker), text.find(end_marker)
        if (text.count(begin_marker) != 1 or text.count(end_marker) != 1
                or end <= begin):
            errors.append(issue("cover.markers", path, f"{kind} 标记缺失、重复或顺序错误"))
            continue
        if kind == "COVER":
            cover_end = end + len(end_marker)
        elif cover_end < 0 or begin < cover_end:
            errors.append(issue("cover.markers", path, "文末控制信息必须位于封面之后且不能嵌套"))
            continue
        blocks[kind] = text[begin + len(begin_marker):end]

    rows: dict[str, str] = {}
    front_fields: set[str] = set()
    for kind, block in blocks.items():
        for key, value in re.findall(r"^\|\s*([^|]+?)\s*\|\s*([^|]*?)\s*\|\s*$", block, re.MULTILINE):
            field = key.strip()
            if field not in COVER_MAP:
                continue
            if kind == "COVER":
                front_fields.add(field)
            if field in rows:
                errors.append(issue("cover.duplicate", path, f"控制字段重复: {field}"))
            rows[field] = strip_cover_value(value)
    if "CONTROL" in blocks:
        for field in sorted(COMPACT_COVER_FIELDS - front_fields):
            errors.append(issue("cover.missing", path, f"短封面缺少必要字段 {field}"))
    for field in COVER_MAP:
        if field not in rows:
            errors.append(issue("cover.missing", path, f"封面/文末控制信息缺少字段 {field}"))
            continue
        expected = expected_cover_value(field, metadata)
        if rows[field] != expected:
            errors.append(issue(
                "cover.mismatch", path,
                f"{field} 与 metadata 不一致: cover={rows[field]!r}, metadata={expected!r}"
            ))
    return errors


def validate_markdown(path: Path, metadata: dict | None) -> list[dict]:
    errors: list[dict] = []
    try:
        text = path.read_text(errors="replace")
    except OSError as exc:
        return [issue("markdown.read", path, f"Markdown 无法读取: {exc}")]
    if not re.search(r"^#\s+\S", text, re.MULTILINE):
        errors.append(issue("markdown.h1", path, "缺少一级标题"))
    if re.search(r"\{\{[^}]+\}\}", text):
        errors.append(issue("markdown.variable", path, "存在未解析模板变量"))

    if metadata is not None:
        errors.extend(validate_cover(path, text, metadata))

    for target in re.findall(r"\[[^]]*\]\(([^)]+)\)", text):
        if target.startswith(("http://", "https://", "#", "mailto:")):
            continue
        clean = target.split("#", 1)[0]
        if clean and not (path.parent / clean).resolve().exists():
            errors.append(issue("link.missing", path, f"本地链接失效: {target}"))
    return errors


def validate_metadata(path: Path, schema: dict, catalog: dict, project_root: Path | None,
                      source_artifacts: dict[str, str]) -> tuple[list[dict], dict | None, Path | None]:
    errors: list[dict] = []
    try:
        data = load_json(path)
    except Exception as exc:
        return [issue("metadata.json", path, f"JSON 无法解析: {exc}")], None, None
    errors.extend(schema_issues(path, data, schema, "metadata.schema"))
    document = path.with_name(path.name.removesuffix(".metadata.json") + ".md")
    if not document.exists():
        errors.append(issue("metadata.document", path, f"找不到同名 Markdown 文档 {document.name}"))
        document = None

    template_id = data.get("template_id")
    relative_template = catalog["templates"].get(template_id)
    expected_template_version = catalog.get("template_versions", {}).get(template_id)
    if relative_template is None:
        errors.append(issue("template.catalog", path, f"template_id 不在 catalog: {template_id}"))
    elif expected_template_version is None:
        errors.append(issue("template.version-catalog", path,
                            f"template_id 没有独立模板版本: {template_id}"))
    else:
        template_path = f"templates/{relative_template}"
        expected_hash = source_artifacts.get(template_path)
        if expected_hash is None and data.get("template_version") == expected_template_version:
            expected_hash = hashlib.sha256((ROOT / template_path).read_bytes()).hexdigest()
        if expected_hash and data.get("template_sha256") != expected_hash:
            errors.append(issue("template.hash", path, "template_sha256 与锁定模板不一致"))

    if data.get("document_type") != template_id:
        errors.append(issue("metadata.document-type-mismatch", path,
                            "document_type 必须与 template_id 相同"))
    if expected_template_version is not None and data.get("template_version") != expected_template_version:
        errors.append(issue("metadata.template-version-mismatch", path,
                            "metadata.template_version 与该 template_id 的独立版本不一致"))

    if project_root is not None and document is not None:
        expected_path = document.resolve().relative_to(project_root.resolve()).as_posix()
        if data.get("source_path") != expected_path:
            errors.append(issue("metadata.canonical-path", path,
                                f"source_path 与实际仓库相对路径不一致: {expected_path}"))
    elif document is not None and data.get("source_path") and not data["source_path"].endswith(document.name):
        errors.append(issue("metadata.canonical-path", path, "source_path 与文档文件名不一致"))
    return errors, data, document


def validate_project_control(project_root: Path, require_immutable: bool) -> tuple[list[dict], dict[str, str], dict | None]:
    errors: list[dict] = []
    artifacts: dict[str, str] = {}
    lock_path = project_root / "docs/std.lock.json"
    if not lock_path.exists():
        return [issue("lock.missing", lock_path, "项目根模式必须提交 docs/std.lock.json")], artifacts, None
    try:
        lock = load_json(lock_path)
    except Exception as exc:
        return [issue("lock.json", lock_path, f"JSON 无法解析: {exc}")], artifacts, None
    errors.extend(schema_issues(lock_path, lock, load_json(ROOT / "schemas/std-lock.schema.json"), "lock.schema"))
    readme_path = project_root / "README.md"
    if not readme_path.is_file():
        errors.append(issue("readme.missing", readme_path,
                            "项目必须在 README.md 记录当前采用的 STD 版本"))
    else:
        try:
            readme = readme_path.read_text(errors="replace")
        except OSError as exc:
            errors.append(issue("readme.read", readme_path, f"README 无法读取: {exc}"))
        else:
            std_version = lock.get("std_version")
            adoption_line = re.compile(
                rf"(?im)^.*\bSTD\b[^\n]*`{re.escape(str(std_version))}`[^\n]*$"
            )
            if not adoption_line.search(readme):
                errors.append(issue(
                    "readme.std-version", readme_path,
                    "README 必须以含 STD 和反引号版本号的同一行记录 docs/std.lock.json.std_version"
                ))
    if require_immutable and not lock.get("source_revision"):
        errors.append(issue("lock.immutable", lock_path, "READY/正式候选必须锁定 immutable source_revision"))
    elif require_immutable and not re.fullmatch(r"[a-f0-9]{40}", str(lock.get("source_revision", ""))):
        errors.append(issue("lock.immutable-format", lock_path,
                            "source_revision 必须是完整 40 位 commit SHA，不能使用 branch、HEAD 或 tag 名"))
    elif require_immutable:
        try:
            locked_commit = subprocess.run(
                ["git", "-C", str(ROOT), "rev-parse", f"{lock['source_revision']}^{{commit}}"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            checkout_commit = subprocess.run(
                ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            if locked_commit != checkout_commit:
                errors.append(issue(
                    "lock.checkout-mismatch", lock_path,
                    "validator 所在 STD checkout 与 source_revision 不是同一 commit"
                ))
            dirty = subprocess.run(
                ["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=all"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            if dirty:
                errors.append(issue("lock.checkout-dirty", lock_path,
                                    "validator 所在 STD checkout 必须 clean，才能证明锁定 commit 内容"))
        except (OSError, subprocess.CalledProcessError):
            errors.append(issue("lock.revision-unresolved", lock_path,
                                "source_revision 无法在 validator 所在 STD checkout 解析"))
        source_tag = lock.get("source_tag")
        if source_tag:
            try:
                tag_type = subprocess.run(
                    ["git", "-C", str(ROOT), "cat-file", "-t", source_tag],
                    check=True, capture_output=True, text=True,
                ).stdout.strip()
                tag_commit = subprocess.run(
                    ["git", "-C", str(ROOT), "rev-parse", f"{source_tag}^{{commit}}"],
                    check=True, capture_output=True, text=True,
                ).stdout.strip()
                if tag_type != "tag":
                    errors.append(issue("lock.tag-not-annotated", lock_path,
                                        "source_tag 必须是 annotated tag"))
                if tag_commit != lock.get("source_revision"):
                    errors.append(issue("lock.tag-mismatch", lock_path,
                                        "source_tag 没有 peel 到 source_revision"))
            except (OSError, subprocess.CalledProcessError):
                errors.append(issue("lock.tag-unresolved", lock_path,
                                    "source_tag 无法在 validator 所在 STD checkout 解析"))
    manifest_rel = lock.get("source_manifest_path")
    if not isinstance(manifest_rel, str):
        return errors, artifacts, lock
    manifest_path = project_root / manifest_rel
    if not manifest_path.exists():
        errors.append(issue("source-manifest.missing", manifest_path, "找不到锁定的 source manifest"))
        return errors, artifacts, lock
    try:
        manifest = load_json(manifest_path)
    except Exception as exc:
        errors.append(issue("source-manifest.json", manifest_path, f"JSON 无法解析: {exc}"))
        return errors, artifacts, lock
    errors.extend(schema_issues(manifest_path, manifest,
                                load_json(ROOT / "schemas/std-source-manifest.schema.json"),
                                "source-manifest.schema"))
    for key in ("std_version", "source_repository", "source_revision", "source_tag"):
        if lock.get(key) != manifest.get(key):
            errors.append(issue("lock.source-mismatch", lock_path, f"{key} 与 source manifest 不一致"))
    for item in manifest.get("artifacts", []):
        if isinstance(item, dict) and isinstance(item.get("path"), str) and isinstance(item.get("sha256"), str):
            artifacts[item["path"]] = item["sha256"]
            source = ROOT / item["path"]
            if not source.is_file():
                errors.append(issue("source-manifest.artifact-missing", manifest_path,
                                    f"当前 STD checkout 缺少 {item['path']}"))
            elif hashlib.sha256(source.read_bytes()).hexdigest() != item["sha256"]:
                errors.append(issue("source-manifest.hash-mismatch", manifest_path,
                                    f"当前 STD checkout 内容与清单不一致: {item['path']}"))
    catalog_path = "templates/catalog.json"
    if catalog_path not in artifacts:
        errors.append(issue("source-manifest.catalog-missing", manifest_path,
                            "source manifest 必须锁定 templates/catalog.json"))
    missing_sources = sorted(expected_source_paths() - set(artifacts))
    if missing_sources:
        errors.append(issue("source-manifest.incomplete", manifest_path,
                            "source manifest 漏掉当前 STD 来源: " + ", ".join(missing_sources)))
    return errors, artifacts, lock


def validate_conformance_refs(records: list[tuple[Path, dict]], project_root: Path | None) -> list[dict]:
    if project_root is None:
        return []
    errors: list[dict] = []
    by_id = {data.get("document_id"): (path, data) for path, data in records}
    for path, data in records:
        if data.get("template_conformance") == "tailored":
            reference = data.get("tailoring_ref")
            target = by_id.get(reference)
            if target is None:
                errors.append(issue("conformance.tailoring-ref-missing", path,
                                    f"tailoring_ref 找不到项目内 Document ID: {reference}"))
            elif target[1].get("template_id") != "management.tailoring":
                errors.append(issue("conformance.tailoring-ref-type", path,
                                    "tailoring_ref 必须指向 management.tailoring 文档"))
        if data.get("template_conformance") == "legacy-mapped":
            reference = data.get("migration_map_ref")
            if isinstance(reference, str):
                target = (project_root / reference).resolve()
                try:
                    target.relative_to(project_root.resolve())
                except ValueError:
                    errors.append(issue("conformance.migration-map-escape", path,
                                        "migration_map_ref 不能离开项目根"))
                else:
                    if not target.is_file():
                        errors.append(issue("conformance.migration-map-missing", path,
                                            f"migration_map_ref 文件不存在: {reference}"))
    return errors


def validate_design_hierarchy(records: list[tuple[Path, dict]]) -> tuple[list[dict], dict[str, int]]:
    """Explicit closed-input hierarchy audit; no file traversal outside supplied records."""
    errors = []
    by_id = {}
    for path, data in records:
        key = data.get("document_id")
        if not isinstance(key, str):
            continue
        if key in by_id:
            errors.append(issue("hierarchy.ambiguous-id", path, f"父链 Document ID 不唯一: {key}"))
        by_id[key] = (path, data)
    if errors:
        return errors, {}
    depths = {}
    for key, (path, data) in by_id.items():
        level = data.get("design_level")
        if data.get("template_id") == "design.subsystem" and level != "subsystem":
            errors.append(issue("hierarchy.type", path, "design.subsystem 必须保持 design_level=subsystem"))
        parent = data.get("parent_document_id")
        if level == "subsystem" and parent is None:
            errors.append(issue("hierarchy.parent-required", path, "子系统需要直属父设计；缺失不能推断为一级"))
            continue
        if parent is None:
            continue
        seen = {key}
        current = data
        depth = 1 if level == "subsystem" else 0
        while current.get("parent_document_id") is not None:
            reference = current["parent_document_id"]
            if not isinstance(reference, str) or reference not in by_id:
                errors.append(issue("hierarchy.parent-missing", path, "父文档不在本次完整输入中，不能计算层级"))
                break
            if reference in seen:
                errors.append(issue("hierarchy.cycle", path, "父链自指或成环"))
                break
            seen.add(reference)
            ancestor = by_id[reference][1]
            if ancestor.get("project") != data.get("project"):
                errors.append(issue("hierarchy.project", path, "父设计必须属于同一项目；外部依赖用引用表达"))
                break
            if not str(ancestor.get("template_id", "")).startswith("design."):
                errors.append(issue("hierarchy.parent-type", path, "父对象必须是设计文档，不是评审或需求记录"))
                break
            if current.get("design_level") == "subsystem" and ancestor.get("design_level") not in {"system", "subsystem"}:
                errors.append(issue("hierarchy.parent-type", path, "子系统的父对象必须是系统或子系统，不能是模块"))
                break
            if ancestor.get("template_id") == "design.subsystem" and ancestor.get("design_level") != "subsystem":
                errors.append(issue("hierarchy.type", path, "父链存在类型与层级矛盾"))
                break
            depth += ancestor.get("design_level") == "subsystem"
            current = ancestor
        else:
            if level == "subsystem":
                if current.get("design_level") != "system":
                    errors.append(issue("hierarchy.root", path, "子系统父链必须到达 design_level=system 的根设计"))
                else:
                    depths[key] = depth
    return errors, depths


def baseline_fingerprints(path: Path | None) -> set[str]:
    if path is None:
        return set()
    data = load_json(path)
    if data.get("schema_version") != "std-validation-baseline.v1":
        raise ValueError("baseline schema_version 非法")
    return set(data.get("fingerprints", []))


def main() -> int:
    global FINGERPRINT_ROOT
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="*", type=Path, help="显式校验的一个或多个根目录")
    parser.add_argument("--project-root", type=Path, help="只发现项目中已声明的 STD 实例")
    parser.add_argument("--require-immutable-std", action="store_true")
    parser.add_argument("--check-design-hierarchy", action="store_true",
                        help="显式检查所提供完整设计父链；缺父、环、跨项目和子系统类型错误均失败")
    parser.add_argument("--baseline", type=Path, help="已批准的历史问题指纹基线")
    parser.add_argument("--write-baseline", type=Path, help="把当前问题写为候选基线")
    parser.add_argument("--json", nargs="?", const="-", metavar="FILE",
                        help="输出机器可读 JSON；省略 FILE 时写 stdout")
    args = parser.parse_args()

    if jsonschema is None:
        print("validate-design requires the jsonschema package", file=sys.stderr)
        return 2
    if bool(args.project_root) == bool(args.paths):
        parser.error("必须二选一：--project-root，或一个/多个 paths")
    roots = [path.resolve() for path in (args.paths or [args.project_root])]
    if any(not path.exists() for path in roots):
        parser.error("目标路径不存在")

    project_root = args.project_root.resolve() if args.project_root else None
    FINGERPRINT_ROOT = project_root or (roots[0] if len(roots) == 1 else None)
    errors: list[dict] = []
    source_artifacts: dict[str, str] = {}
    lock: dict | None = None
    if project_root:
        control_errors, source_artifacts, lock = validate_project_control(project_root, args.require_immutable_std)
        errors.extend(control_errors)

    catalog = load_json(ROOT / "templates/catalog.json")
    metadata_schema = load_json(ROOT / "schemas/document-metadata.schema.json")
    metadata_paths = sorted({path for root in roots for path in discover(root, ".metadata.json")})
    markdown_paths: set[Path] = set()
    identities: dict[str, Path] = {}
    metadata_records: list[tuple[Path, dict]] = []
    for path in metadata_paths:
        found, data, document = validate_metadata(
            path, metadata_schema, catalog, project_root, source_artifacts
        )
        errors.extend(found)
        if data:
            metadata_records.append((path, data))
        if data and isinstance(data.get("document_id"), str):
            document_id = data["document_id"]
            if document_id in identities:
                errors.append(issue("metadata.duplicate-id", path,
                                    f"document_id 重复，首次出现在 {identities[document_id]}"))
            else:
                identities[document_id] = path
        if document:
            markdown_paths.add(document)
            errors.extend(validate_markdown(document, data))
    errors.extend(validate_conformance_refs(metadata_records, project_root))
    hierarchy_depths = {}
    if args.check_design_hierarchy:
        hierarchy_errors, hierarchy_depths = validate_design_hierarchy(metadata_records)
        errors.extend(hierarchy_errors)

    decision_schema = load_json(ROOT / "schemas/review-decision.schema.json")
    decision_paths = sorted({path for root in roots for path in discover(root, ".review-decision.json")})
    for path in decision_paths:
        try:
            decision = load_json(path)
        except Exception as exc:
            errors.append(issue("review-decision.json", path, f"JSON 无法解析: {exc}"))
            continue
        errors.extend(schema_issues(path, decision, decision_schema, "review-decision.schema"))

    if project_root:
        for path in discover(project_root, ".md"):
            try:
                text = path.read_text(errors="replace")
            except OSError as exc:
                errors.append(issue("markdown.read", path, f"Markdown 无法读取: {exc}"))
                continue
            if "<!-- STD_DOCUMENT_COVER_BEGIN -->" in text and path not in markdown_paths:
                errors.append(issue("metadata.missing", path, "STD 封面文档缺少同名 metadata"))
    else:
        for root in roots:
            for path in discover(root, ".md"):
                if path not in markdown_paths:
                    markdown_paths.add(path)
                    errors.extend(validate_markdown(path, None))

    try:
        inherited = baseline_fingerprints(args.baseline)
    except Exception as exc:
        print(f"invalid baseline: {exc}", file=sys.stderr)
        return 2
    for item in errors:
        item["classification"] = "inherited" if item["fingerprint"] in inherited else "new"
    new_errors = [item for item in errors if item["classification"] == "new"]
    inherited_errors = [item for item in errors if item["classification"] == "inherited"]

    if args.write_baseline:
        args.write_baseline.parent.mkdir(parents=True, exist_ok=True)
        args.write_baseline.write_text(json.dumps({
            "schema_version": "std-validation-baseline.v1",
            "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "fingerprints": sorted(item["fingerprint"] for item in errors),
        }, ensure_ascii=False, indent=2) + "\n")

    result = {
        "schema_version": "std-validation-result.v1", "ok": not new_errors,
        "new_error_count": len(new_errors), "inherited_error_count": len(inherited_errors),
        "checked_metadata": len(metadata_paths), "checked_markdown": len(markdown_paths),
        "checked_decisions": len(decision_paths),
        "issues": errors,
    }
    if args.json:
        if args.check_design_hierarchy:
            result["subsystem_depths"] = hierarchy_depths
        rendered = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
        if args.json == "-":
            print(rendered, end="")
        else:
            json_path = Path(args.json)
            json_path.parent.mkdir(parents=True, exist_ok=True)
            json_path.write_text(rendered)
    elif errors:
        print("STD validation completed:")
        for item in errors:
            print(f"- [{item['classification']}] {item['code']} {item['path']}: {item['message']}")
        print(f"new={len(new_errors)} inherited={len(inherited_errors)}")
    else:
        print(
            f"STD validation OK: metadata={len(metadata_paths)} "
            f"markdown={len(markdown_paths)} decisions={len(decision_paths)}"
        )
    return 1 if new_errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
