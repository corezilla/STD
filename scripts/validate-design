#!/usr/bin/env python3
"""STD 文档实例结构、Schema、封面、来源与链接 validator。"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

try:
    import jsonschema
except ImportError:
    jsonschema = None


ROOT = Path(__file__).resolve().parents[1]
FINGERPRINT_ROOT: Path | None = None
EXCLUDED_PARTS = {
    ".git", ".cache", ".local", ".venv", "__pycache__", "node_modules",
    "vendor", "third_party", "build", "dist", "DATA"
}
STATUS_LABELS = {
    "draft": "Draft", "review": "In Review", "accepted": "Approved",
    "released": "Released", "superseded": "Superseded", "retired": "Retired"
}
COVER_MAP = {
    "Document ID": "document_id", "Document Version": "document_version",
    "Status": "status", "Project": "project", "Authority": "authority",
    "Document Owner": "document_owner", "Authors": "authors",
    "Created Date": "created_at", "Last Modified Date": "last_modified_at",
    "STD Version": "std_version", "Template ID": "template_id",
    "Template Conformance": "template_conformance",
    "Tailoring Reference": "tailoring_ref",
    "Migration Map Reference": "migration_map_ref",
    "Repository": "source_repository", "Canonical Path": "source_path",
    "Supersedes": "supersedes",
}


def load_json(path: Path):
    return json.loads(path.read_text())


def issue(code: str, path: Path, message: str) -> dict:
    try:
        stable_path = path.resolve().relative_to(FINGERPRINT_ROOT).as_posix() if FINGERPRINT_ROOT else str(path)
    except ValueError:
        stable_path = str(path)
    fingerprint = hashlib.sha256(f"{code}|{stable_path}|{message}".encode()).hexdigest()
    return {"code": code, "path": str(path), "message": message, "fingerprint": fingerprint}


def schema_issues(path: Path, data, schema: dict, code: str) -> list[dict]:
    validator = jsonschema.Draft202012Validator(
        schema, format_checker=jsonschema.FormatChecker()
    )
    result = []
    for error in sorted(validator.iter_errors(data), key=lambda item: list(item.absolute_path)):
        location = "/".join(str(part) for part in error.absolute_path) or "<root>"
        result.append(issue(code, path, f"{location}: {error.message}"))
    return result


def discover(root: Path, suffix: str) -> list[Path]:
    return sorted(
        path for path in root.rglob(f"*{suffix}")
        if not any(part in EXCLUDED_PARTS for part in path.relative_to(root).parts)
    )


def strip_cover_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == "`":
        value = value[1:-1]
    return value.strip()


def expected_cover_value(field: str, data: dict) -> str:
    value = data.get(COVER_MAP[field])
    if field == "Status":
        return STATUS_LABELS.get(value, str(value))
    if field == "Authors" and isinstance(value, list):
        return ", ".join(value)
    return "none" if value is None else str(value)


def validate_markdown(path: Path, metadata: dict | None) -> list[dict]:
    text = path.read_text(errors="replace")
    errors: list[dict] = []
    if not re.search(r"^#\s+\S", text, re.MULTILINE):
        errors.append(issue("markdown.h1", path, "缺少一级标题"))
    if re.search(r"\{\{[^}]+\}\}", text):
        errors.append(issue("markdown.variable", path, "存在未解析模板变量"))

    if metadata is not None:
        if "<!-- STD_DOCUMENT_COVER_BEGIN -->" not in text or "<!-- STD_DOCUMENT_COVER_END -->" not in text:
            errors.append(issue("cover.markers", path, "缺少 STD 文档封面标记"))
        rows = {
            key.strip(): strip_cover_value(value)
            for key, value in re.findall(r"^\|\s*([^|]+?)\s*\|\s*([^|]*?)\s*\|\s*$", text, re.MULTILINE)
        }
        for field in COVER_MAP:
            if field not in rows:
                errors.append(issue("cover.missing", path, f"封面缺少字段 {field}"))
                continue
            expected = expected_cover_value(field, metadata)
            if rows[field] != expected:
                errors.append(issue(
                    "cover.mismatch", path,
                    f"{field} 与 metadata 不一致: cover={rows[field]!r}, metadata={expected!r}"
                ))

    for target in re.findall(r"\[[^]]*\]\(([^)]+)\)", text):
        if target.startswith(("http://", "https://", "#", "mailto:")):
            continue
        clean = target.split("#", 1)[0]
        if clean and not (path.parent / clean).resolve().exists():
            errors.append(issue("link.missing", path, f"本地链接失效: {target}"))
    return errors


def validate_metadata(path: Path, schema: dict, catalog: dict, project_root: Path | None,
                      source_artifacts: dict[str, str]) -> tuple[list[dict], dict | None, Path | None]:
    errors: list[dict] = []
    try:
        data = load_json(path)
    except Exception as exc:
        return [issue("metadata.json", path, f"JSON 无法解析: {exc}")], None, None
    errors.extend(schema_issues(path, data, schema, "metadata.schema"))
    document = path.with_name(path.name.removesuffix(".metadata.json") + ".md")
    if not document.exists():
        errors.append(issue("metadata.document", path, f"找不到同名 Markdown 文档 {document.name}"))
        document = None

    template_id = data.get("template_id")
    relative_template = catalog["templates"].get(template_id)
    if relative_template is None:
        errors.append(issue("template.catalog", path, f"template_id 不在 catalog: {template_id}"))
    else:
        template_path = f"templates/{relative_template}"
        expected_hash = source_artifacts.get(template_path)
        if expected_hash is None and data.get("std_version") == (ROOT / "VERSION").read_text().strip():
            expected_hash = hashlib.sha256((ROOT / template_path).read_bytes()).hexdigest()
        if expected_hash and data.get("template_sha256") != expected_hash:
            errors.append(issue("template.hash", path, "template_sha256 与锁定模板不一致"))

    if project_root is not None and document is not None:
        expected_path = document.resolve().relative_to(project_root.resolve()).as_posix()
        if data.get("source_path") != expected_path:
            errors.append(issue("metadata.canonical-path", path,
                                f"source_path 与实际仓库相对路径不一致: {expected_path}"))
    elif document is not None and data.get("source_path") and not data["source_path"].endswith(document.name):
        errors.append(issue("metadata.canonical-path", path, "source_path 与文档文件名不一致"))
    return errors, data, document


def validate_project_control(project_root: Path, require_immutable: bool) -> tuple[list[dict], dict[str, str]]:
    errors: list[dict] = []
    artifacts: dict[str, str] = {}
    lock_path = project_root / "docs/std.lock.json"
    if not lock_path.exists():
        return [issue("lock.missing", lock_path, "项目根模式必须提交 docs/std.lock.json")], artifacts
    try:
        lock = load_json(lock_path)
    except Exception as exc:
        return [issue("lock.json", lock_path, f"JSON 无法解析: {exc}")], artifacts
    errors.extend(schema_issues(lock_path, lock, load_json(ROOT / "schemas/std-lock.schema.json"), "lock.schema"))
    if require_immutable and not lock.get("source_revision"):
        errors.append(issue("lock.immutable", lock_path, "READY/正式候选必须锁定 immutable source_revision"))
    elif require_immutable:
        try:
            locked_commit = subprocess.run(
                ["git", "-C", str(ROOT), "rev-parse", f"{lock['source_revision']}^{{commit}}"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            checkout_commit = subprocess.run(
                ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
            if locked_commit != checkout_commit:
                errors.append(issue(
                    "lock.checkout-mismatch", lock_path,
                    "validator 所在 STD checkout 与 source_revision 不是同一 commit"
                ))
        except (OSError, subprocess.CalledProcessError):
            errors.append(issue("lock.revision-unresolved", lock_path,
                                "source_revision 无法在 validator 所在 STD checkout 解析"))
    manifest_rel = lock.get("source_manifest_path")
    if not isinstance(manifest_rel, str):
        return errors, artifacts
    manifest_path = project_root / manifest_rel
    if not manifest_path.exists():
        errors.append(issue("source-manifest.missing", manifest_path, "找不到锁定的 source manifest"))
        return errors, artifacts
    try:
        manifest = load_json(manifest_path)
    except Exception as exc:
        errors.append(issue("source-manifest.json", manifest_path, f"JSON 无法解析: {exc}"))
        return errors, artifacts
    errors.extend(schema_issues(manifest_path, manifest,
                                load_json(ROOT / "schemas/std-source-manifest.schema.json"),
                                "source-manifest.schema"))
    for key in ("std_version", "source_repository", "source_revision"):
        if lock.get(key) != manifest.get(key):
            errors.append(issue("lock.source-mismatch", lock_path, f"{key} 与 source manifest 不一致"))
    for item in manifest.get("artifacts", []):
        if isinstance(item, dict) and isinstance(item.get("path"), str) and isinstance(item.get("sha256"), str):
            artifacts[item["path"]] = item["sha256"]
    return errors, artifacts


def baseline_fingerprints(path: Path | None) -> set[str]:
    if path is None:
        return set()
    data = load_json(path)
    if data.get("schema_version") != "std-validation-baseline.v1":
        raise ValueError("baseline schema_version 非法")
    return set(data.get("fingerprints", []))


def main() -> int:
    global FINGERPRINT_ROOT
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="*", type=Path, help="显式校验的一个或多个根目录")
    parser.add_argument("--project-root", type=Path, help="只发现项目中已声明的 STD 实例")
    parser.add_argument("--require-immutable-std", action="store_true")
    parser.add_argument("--baseline", type=Path, help="已批准的历史问题指纹基线")
    parser.add_argument("--write-baseline", type=Path, help="把当前问题写为候选基线")
    parser.add_argument("--json", nargs="?", const="-", metavar="FILE",
                        help="输出机器可读 JSON；省略 FILE 时写 stdout")
    args = parser.parse_args()

    if jsonschema is None:
        print("validate-design requires the jsonschema package", file=sys.stderr)
        return 2
    if bool(args.project_root) == bool(args.paths):
        parser.error("必须二选一：--project-root，或一个/多个 paths")
    roots = [path.resolve() for path in (args.paths or [args.project_root])]
    if any(not path.exists() for path in roots):
        parser.error("目标路径不存在")

    project_root = args.project_root.resolve() if args.project_root else None
    FINGERPRINT_ROOT = project_root or (roots[0] if len(roots) == 1 else None)
    errors: list[dict] = []
    source_artifacts: dict[str, str] = {}
    if project_root:
        control_errors, source_artifacts = validate_project_control(project_root, args.require_immutable_std)
        errors.extend(control_errors)

    catalog = load_json(ROOT / "templates/catalog.json")
    metadata_schema = load_json(ROOT / "schemas/document-metadata.schema.json")
    metadata_paths = sorted({path for root in roots for path in discover(root, ".metadata.json")})
    markdown_paths: set[Path] = set()
    identities: dict[str, Path] = {}
    for path in metadata_paths:
        found, data, document = validate_metadata(path, metadata_schema, catalog, project_root, source_artifacts)
        errors.extend(found)
        if data and isinstance(data.get("document_id"), str):
            document_id = data["document_id"]
            if document_id in identities:
                errors.append(issue("metadata.duplicate-id", path,
                                    f"document_id 重复，首次出现在 {identities[document_id]}"))
            else:
                identities[document_id] = path
        if document:
            markdown_paths.add(document)
            errors.extend(validate_markdown(document, data))

    if project_root:
        for path in discover(project_root, ".md"):
            text = path.read_text(errors="replace")
            if "<!-- STD_DOCUMENT_COVER_BEGIN -->" in text and path not in markdown_paths:
                errors.append(issue("metadata.missing", path, "STD 封面文档缺少同名 metadata"))
    else:
        for root in roots:
            for path in discover(root, ".md"):
                if path not in markdown_paths:
                    markdown_paths.add(path)
                    errors.extend(validate_markdown(path, None))

    try:
        inherited = baseline_fingerprints(args.baseline)
    except Exception as exc:
        print(f"invalid baseline: {exc}", file=sys.stderr)
        return 2
    for item in errors:
        item["classification"] = "inherited" if item["fingerprint"] in inherited else "new"
    new_errors = [item for item in errors if item["classification"] == "new"]
    inherited_errors = [item for item in errors if item["classification"] == "inherited"]

    if args.write_baseline:
        args.write_baseline.parent.mkdir(parents=True, exist_ok=True)
        args.write_baseline.write_text(json.dumps({
            "schema_version": "std-validation-baseline.v1",
            "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "fingerprints": sorted(item["fingerprint"] for item in errors),
        }, ensure_ascii=False, indent=2) + "\n")

    result = {
        "schema_version": "std-validation-result.v1", "ok": not new_errors,
        "new_error_count": len(new_errors), "inherited_error_count": len(inherited_errors),
        "checked_metadata": len(metadata_paths), "checked_markdown": len(markdown_paths),
        "issues": errors,
    }
    if args.json:
        rendered = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
        if args.json == "-":
            print(rendered, end="")
        else:
            json_path = Path(args.json)
            json_path.parent.mkdir(parents=True, exist_ok=True)
            json_path.write_text(rendered)
    elif errors:
        print("STD validation completed:")
        for item in errors:
            print(f"- [{item['classification']}] {item['code']} {item['path']}: {item['message']}")
        print(f"new={len(new_errors)} inherited={len(inherited_errors)}")
    else:
        print(f"STD validation OK: metadata={len(metadata_paths)} markdown={len(markdown_paths)}")
    return 1 if new_errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
